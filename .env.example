# Single-brand: the subdomain (the part before .zendesk.com)
ZENDESK_SUBDOMAIN=your-subdomain

# Multi-brand (v0.4+): comma-separated list of brand subdomains. Overrides
# ZENDESK_SUBDOMAIN if both are set. Primary brand is first in the list.
# ZENDESK_BRANDS=help-admin,help-partners

# Email of the Zendesk user the API token belongs to
ZENDESK_EMAIL=you@example.com

# API token from Admin Center → Apps and integrations → Zendesk API
ZENDESK_API_TOKEN=your_api_token_here

# Optional overrides
# ZENDESK_API_TIMEOUT=10000
# RATE_LIMIT_GLOBAL=100
# RATE_LIMIT_WINDOW_MS=60000
# LOG_LEVEL=info
# LOG_PRETTY=false
